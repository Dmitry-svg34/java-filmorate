<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">


<module name="Checker">
	<property name="severity" value="error"/>
	<property name="charset" value="UTF-8"/>
	<property name="fileExtensions" value="java, properties, xml"/>

	<!-- Максимальная длина строки -->
	<module name="LineLength">
		<property name="fileExtensions" value="java"/>
		<property name="max" value="120"/>
		<property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
	</module>

	<!-- Файл должен заканчиваться переводом строки -->
	<module name="NewlineAtEndOfFile"/>

	<!-- Запрет trailing whitespace в конце строк -->
	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="minimum" value="0"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Trailing whitespace"/>
	</module>

	<!-- Tab вместо пробелов в отступах запрещён (Google: только пробелы) -->
	<module name="FileTabCharacter">
		<property name="eachLine" value="true"/>
	</module>

	<module name="TreeWalker">
		<!-- Запрет пакетов *.shaded.* -->
		<module name="IllegalImport">
			<property name="regexp" value="true"/>
			<property name="illegalPkgs" value=".*\.shaded\..*"/>
		</module>

		<module name="OuterTypeFilename"/>

		<!-- Запрет служебных escape-последовательностей в строках и символах -->
		<module name="IllegalTokenText">
			<property name="tokens" value="STRING_LITERAL,CHAR_LITERAL"/>
			<property name="format" value="\\u00(09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))"/>
		</module>
	</module>
</module>
